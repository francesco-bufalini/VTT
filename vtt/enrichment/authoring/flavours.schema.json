{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VTT trait flavour catalog v2 (not a benefit type)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_type",
    "scope",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "catalog_type": {
      "const": "flavours"
    },
    "scope": {
      "const": "catalog"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "granted_by",
          "flavours"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "granted_by": {
            "oneOf": [
              {
                "$ref": "catalog.schema.json#/$defs/five"
              },
              {
                "$ref": "catalog.schema.json#/$defs/home"
              }
            ]
          },
          "label": {
            "type": "string"
          },
          "trigger": {
            "enum": [
              "level_up",
              "short_rest",
              "long_rest",
              null
            ]
          },
          "flavours": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "legacy_mode": {
                  "enum": [
                    "ability",
                    "feat"
                  ]
                },
                "legacy_ability": {
                  "type": "string"
                },
                "legacy_ancestry": {
                  "type": "string"
                },
                "legacy_subrace": {"type":"string"},
                "legacy_subrace_source": {"type":"string"},
                "requires_untrained_saving_throw": {
                  "type": "boolean"
                }
              }
            }
          },
          "migrate_proficiencies": {
            "type": "array",
            "items": {
              "enum": [
                "save",
                "skill",
                "weapon",
                "armor",
                "tool",
                "language"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

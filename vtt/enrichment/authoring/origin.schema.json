{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VTT source-oriented enrichment file v2",
  "description": "One file per class/species/feat/item/background/spell (or cohesive group). Links to 5eTools by canonical identity, and stores only additional mechanics. Name/description optional for homebrew.",
  "type": "object",
  "required": [
    "schema_version",
    "category",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "category": {
      "enum": [
        "classes",
        "subclasses",
        "species",
        "subraces",
        "feats",
        "items",
        "backgrounds",
        "spells",
        "optional_features",
        "monsters",
        "conditions"
      ]
    },
    "source": {
      "type": "string",
      "description": "Default book/source of the file (entry ref source takes priority)."
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$",
      "description": "Optional homebrew namespace."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "notes": {
      "type": "string",
      "description": "Editorial notes, not material shown instead of 5eTools."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "description": "5eTools identity: name + source + context (or stable catalog ID). Do not use localized display names for lookup.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "enum": [
            "2014",
            "2024",
            "other"
          ]
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        },
        "class_source": {
          "type": "string",
          "minLength": 1
        },
        "subclass": {
          "type": "string",
          "minLength": 1
        },
        "subclass_source": {
          "type": "string",
          "minLength": 1
        },
        "race": {
          "type": "string",
          "minLength": 1
        },
        "race_source": {
          "type": "string",
          "minLength": 1
        },
        "subrace": {
          "type": "string",
          "minLength": 1
        },
        "subrace_source": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "feature_type": {
          "type": "string",
          "minLength": 1
        },
        "homebrew_namespace": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "name",
            "source"
          ]
        }
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional author-supplied title (mainly homebrew); 5eTools supplies official display titles."
        },
        "description": {
          "type": "string",
          "description": "Optional author-supplied text (mainly homebrew); 5eTools supplies official prose."
        },
        "homebrew": {
          "type": "boolean",
          "default": false
        },
        "min_level": {
          "type": "integer",
          "minimum": 0
        },
        "max_level": {
          "type": "integer",
          "minimum": 0
        },
        "rules_version": {
          "enum": [
            "2014",
            "2024",
            "both"
          ]
        },
        "requirements": {
          "$ref": "benefit.schema.json#/$defs/requirements"
        },
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "benefit.schema.json"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "subclasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "subraces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "reprint_of": {
          "$ref": "#/$defs/ref"
        },
        "spell_geometry": {
          "$ref": "spell_geometry.schema.json"
        },
        "properties": {
          "type": "object",
          "description": "Structured source-specific item/spell/monster attributes; no extra 5eTools prose.",
          "additionalProperties": true
        },
        "notes": {
          "type": "string",
          "description": "Editorial metadata only, never used as rules."
        },
        "spell_runtime": {
          "$ref": "#/$defs/spellRuntime"
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional author-supplied title (mainly homebrew); 5eTools supplies official display titles."
        },
        "description": {
          "type": "string",
          "description": "Optional author-supplied text (mainly homebrew); 5eTools supplies official prose."
        },
        "homebrew": {
          "type": "boolean",
          "default": false
        },
        "min_level": {
          "type": "integer",
          "minimum": 0
        },
        "max_level": {
          "type": "integer",
          "minimum": 0
        },
        "rules_version": {
          "enum": [
            "2014",
            "2024",
            "both"
          ]
        },
        "requirements": {
          "$ref": "benefit.schema.json#/$defs/requirements"
        },
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "benefit.schema.json"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "subclasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "subraces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "reprint_of": {
          "$ref": "#/$defs/ref"
        },
        "spell_geometry": {
          "$ref": "spell_geometry.schema.json"
        },
        "properties": {
          "type": "object",
          "description": "Structured source-specific item/spell/monster attributes; no extra 5eTools prose.",
          "additionalProperties": true
        },
        "notes": {
          "type": "string",
          "description": "Editorial metadata only, never used as rules."
        },
        "spell_runtime": {
          "$ref": "#/$defs/spellRuntime"
        }
      },
      "additionalProperties": false
    },
    "spellRuntime": {
      "type": "object",
      "description": "Typed spell execution metadata currently stored in vtt/enrichment/spells.json; distinct from target/effect geometry.",
      "properties": {
        "movable_aoe_feet": {
          "type": "number",
          "minimum": 0
        },
        "movable_aoe_mode": {
          "type": "string"
        },
        "target_mode": {
          "type": "string"
        },
        "range_feet": {
          "type": "number",
          "minimum": 0
        },
        "base_target_clicks": {
          "type": "integer",
          "minimum": 0
        },
        "aoe_shape": {
          "type": "string"
        },
        "aoe_radius_feet": {
          "type": "number",
          "minimum": 0
        },
        "visual_style": {
          "type": "string"
        },
        "projectile_style": {
          "type": "string"
        },
        "projectile_travel_seconds": {
          "type": "number",
          "minimum": 0
        },
        "meteor_drop_height_feet": {
          "type": "number",
          "minimum": 0
        },
        "requires_ground": {
          "type": "boolean"
        },
        "transient_seconds": {
          "type": "number",
          "minimum": 0
        },
        "forced_movement_feet": {
          "type": "number",
          "minimum": 0
        },
        "forced_movement_mode": {
          "type": "string"
        },
        "forced_movement_on_failed_save": {
          "type": "boolean"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}

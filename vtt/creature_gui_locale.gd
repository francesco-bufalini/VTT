static func read_locale() -> String:
	var config := ConfigFile.new()
	if config.load(CONFIG_PATH) == OK:
		var value := String(config.get_value("creature_gui", "language", "it"))
		if value in ["it", "en"]:
			return value
	return "it"

static func write_locale(language: String) -> void:
	if language not in ["it", "en"]:
		return
	var config := ConfigFile.new()
	config.set_value("creature_gui", "language", language)
	config.save(CONFIG_PATH)

static func text_for(source: String, language: String) -> String:
	var dictionary: Dictionary = EN if language == "en" else IT
	if dictionary.has(source):
		return String(dictionary[source])
	if language == "en":
		# Formatted GUI labels keep their variable values (creature names, counts,
		# spell names, IDs) untouched. Only recognized UI templates are translated.
		for template: String in [
			"Camminata: base %d + bonus cumulabili %+d = %d ft",
			"%s: base %d + bonus specifici %+d",
			"Competenza: base %+d %+d bonus da origini = %+d",
			"%s: mod. %s %+d + competenza %d × %+d + bonus origini %+d = %+d",
			"%s: mod. %+d + competenza o bestiario %+d + origini %+d = %+d",
			"Percezione passiva: 10 + Percezione %+d + bonus propri %+d = %d",
			"Danni: %s. Include i bonus di caratteristica, arma e concessioni applicabili.",
			"Gittata: base %d ft + bonus cumulabili %+d ft = %d ft",
			"CA: %s + scudo %+d + bonus cumulabili %+d = %d",
			"Iniziativa: modificatore DES %+d + bonus cumulabili %+d = %+d",
			"PF massimi: base %d + bonus cumulabili %+d = %d",
			"PF seconda forma: base %d %+d origini = %d",
			"%s: floor((%d - 10) / 2) %+d bonus sul modificatore = %+d",
			"%s: base %d + bonus cumulabili %+d = %d",
			"Slot livello %d: base %d + bonus cumulabili %+d = %d",
			"Magia del Patto: base %d + bonus cumulabili %+d = %d",
			"Come creatura (%s)", "Senza origine (%d)",
			"Livello %d", "%d voci del bestiario ricercabili",
			"%d risultati", "%d° livello · %d rimasti",
			"Patto · %d° livello · %d rimasti",
			"Sottoclasse · %s / %s",
			"%s · %d/%d scelte",
			"Lancia %s (livello %d). Scegli quale slot consumare.",
			"%s lanciato · effetto VTT non attivabile senza un token collegato.",
			"%s lanciato · nessun effetto VTT associato.",
			"Impossibile attivare l'effetto VTT di %s.",
			"Salvataggio non riuscito: %s", "Eliminazione non riuscita: %s",
			"Lettera ricevuta da giocatore %s: %s",
			"I PF della seconda forma di %s sono a 0. Ripristinare l'aspetto di base?",
			"%s · Ricarica d6: %d (%s, occorre %d–6).",
			"Con rincorsa di almeno 10 ft: max(0, 3 + modificatore FOR %+d) = %d ft. ",
			"Eliminare definitivamente '%s' dal tuo archivio?\\nVerranno eliminati anche i suoi token presenti nella scena.",
		]:
			var translated_template: String = _translate_template(source, template)
			if not translated_template.is_empty():
				return translated_template
		# Composite suffixes contain UI instructions attached to data labels.
		for suffix: String in [" · Modifica da Visualizza e modifica → Competenze",
			" (mostrati i primi 120; affina la ricerca)", " · Inserisci PF manualmente."]:
			if source.ends_with(suffix):
				return text_for(source.substr(0, source.length() - suffix.length()), language) + String(EN[suffix])
	if source.contains("\n"):
		var lines := source.split("\n")
		var changed := false
		for index in range(lines.size()):
			var translated := text_for(lines[index], language)
			if translated != lines[index]:
				lines[index] = translated
				changed = true
		if changed:
			return "\n".join(lines)
	# Compose only UI portions (for example skill name · DEX). Catalog names
	# and free-form input are never passed through a broad text replacement.
	if source.contains(" · "):
		var fragments := source.split(" · ")
		var changed := false
		for index in range(fragments.size()):
			var translated := text_for(fragments[index], language)
			if translated != fragments[index]:
				fragments[index] = translated
				changed = true
		if changed:
			return " · ".join(fragments)
	if language == "it":
		for prefix: String in ["Starting ", "Multiclass "]:
			if source.begins_with(prefix):
				return String(IT[prefix]) + source.substr(prefix.length())
		return source
	# Common generated GUI messages: translate fixed labels and leave catalog values intact.
	for prefix in ["Strumenti: ", "Linguaggi: ", "Completa le scelte: ",
		"CA ", "Camminata: ",
		"Con rincorsa (almeno 10 ft): ", "Da fermo (senza rincorsa): ",
		"PF massimi → ", "Competenza → ", "PF non calcolabili: ",
		"Vai al privilegio: ", "Slot dal livello: ",
		"Dadi vita: ", "XP minimi: ", "Iniziativa: ", "Portata ",
		"Massimi derivati dai dati strutturati: ",
		"Esportazione non riuscita: ", "Impossibile salvare resistenze/immunità: ",
		"Salvataggio incantesimi non riuscito: ", "Equipaggiamento non salvato: ",
		"Impossibile salvare attacco: ", "Impossibile salvare i documenti: ",
		"Impossibile salvare competenze: ", "Impossibile salvare inventario: ",
		"Tracker non salvato: ", "PF della forma non disponibili: ",
		"Impossibile salvare gli incantesimi attivi: ",
		"Vulnerabilità: ", "Resistenze: ", "Immunità ai danni: ",
		"Immunità alle condizioni: ", "Senza competenza: ",
		"Cataloghi e integrazioni ricaricati. ", "Fonte: ",
		"⚠ Da scegliere: ",
		"Descrizione · ", "Oggetto · ", "Classe · ", "Tratti del background · ",
		"Creatura esportata: ", "Esportazione non completata: ", "Tiro salvezza ",
		"Taglia · ", "Slot livello ", "Livello ",
		"Competenza: ", "Elimina · ", "Completa · ", "Aggiunto: ",
		"Documento · ", "ID catalogo: ", "Origini:\n"]:
		if source.begins_with(prefix):
			return String(EN[prefix]) + source.substr(prefix.length())
	for fmt: String in ["LIVELLO %d", "%d tratti e descrizioni", "Lunga: %d ft", "Max %d", "Tira d6: ricarica con %d–6", "Consuma uno slot di livello %d",
		"Ricarica uno slot di livello %d"]:
		var parts: PackedStringArray = fmt.split("%d")
		if parts.size() == 2 and source.begins_with(parts[0]) and source.ends_with(parts[1]):
			var middle := source.substr(parts[0].length(), source.length() - parts[0].length() - parts[1].length())
			if middle.is_valid_int():
				return String(EN[fmt]) % int(middle)
	return source

# Match a small, explicit set of UI format strings after their values have been
# interpolated. No blanket translation is applied to compendium/free-form data.
static func _translate_template(source: String, template: String) -> String:
	if not EN.has(template):
		return ""
	var literals: Array[String] = []
	var kinds: Array[String] = []
	var cursor := 0
	while cursor < template.length():
		var marker := template.find("%", cursor)
		if marker < 0:
			break
		var kind := template.substr(marker + 1, 1)
		var width := 2
		if kind == "+":
			kind = template.substr(marker + 2, 1)
			width = 3
		if kind not in ["d", "s"]:
			return ""
		literals.append(template.substr(cursor, marker - cursor))
		kinds.append(kind)
		cursor = marker + width
	if kinds.is_empty():
		return ""
	literals.append(template.substr(cursor))
	var source_cursor := 0
	var values: Array = []
	for i in range(kinds.size()):
		var fixed: String = literals[i]
		if not source.substr(source_cursor).begins_with(fixed):
			return ""
		source_cursor += fixed.length()
		var ending: String = literals[i + 1]
		var next: int = source.find(ending, source_cursor) if not ending.is_empty() else source.length()
		if next < source_cursor:
			return ""
		var value: String = source.substr(source_cursor, next - source_cursor)
		if kinds[i] == "d":
			if not value.is_valid_int():
				return ""
			values.append(int(value))
		else:
			values.append(value)
		source_cursor = next
	if source.substr(source_cursor) != literals[literals.size() - 1]:
		return ""
	return String(EN[template]) % values

static func apply(root: Node, language: String) -> void:
	if root == null or not is_instance_valid(root):
		return
	if (root is Label or root is Button) and not bool(root.get_meta("creature_gui_data", false)) and not (root is OptionButton and root.has_meta("catalog_category")):
		_translate_property(root, "text", language)
	# Opt in only for our computed summaries, never 5etools descriptions.
	if root is RichTextLabel and bool(root.get_meta("creature_gui_text", false)):
		_translate_property(root, "text", language)
	if root is LineEdit or root is TextEdit:
		_translate_property(root, "placeholder_text", language)
	if root is Control and not bool(root.get_meta("creature_gui_data", false)):
		_translate_property(root, "tooltip_text", language)
	if root is Window:
		_translate_property(root, "title", language)
	if root is AcceptDialog:
		_translate_property(root, "dialog_text", language)
		_translate_property(root, "ok_button_text", language)
	if root is ConfirmationDialog:
		_translate_property(root, "cancel_button_text", language)
	if root is TabContainer:
		var tabs := root as TabContainer
		for i in range(tabs.get_tab_count()):
			var tab: Node = tabs.get_tab_control(i)
			var value := tabs.get_tab_title(i)
			var result := _localized(tab, "tab_title", value, language)
			if result != value:
				tabs.set_tab_title(i, result)
	if root is OptionButton and not root.has_meta("catalog_category"):
		var options := root as OptionButton
		for i in range(options.item_count):
			var value := options.get_item_text(i)
			var result := _localized(options, "option_" + str(i), value, language)
			if result != value:
				options.set_item_text(i, result)
	elif root is PopupMenu and not (root.get_parent() is OptionButton and root.get_parent().has_meta("catalog_category")):
		var menu := root as PopupMenu
		for i in range(menu.item_count):
			if menu.is_item_separator(i):
				continue
			var value := menu.get_item_text(i)
			var result := _localized(menu, "item_" + str(i), value, language)
			if result != value:
				menu.set_item_text(i, result)
	for child in root.get_children():
		apply(child, language)

static func _translate_property(node: Object, property_name: String, language: String) -> void:
	var current: String = String(node.get(property_name))
	var localized := _localized(node, property_name, current, language)
	if localized != current:
		node.set(property_name, localized)

static func _localized(node: Object, key: String, current: String, language: String) -> String:
	var initial_key := "creature_locale_original_" + key
	var last_key := "creature_locale_last_" + key
	var locale_key := "creature_locale_language_" + key
	# No redundant translations or layout invalidation during periodic refresh.
	if (node.has_meta(last_key) and current == String(node.get_meta(last_key))
		and String(node.get_meta(locale_key, "")) == language):
		return current
	var original: String = String(node.get_meta(initial_key, current))
	if current != String(node.get_meta(last_key, original)):
		original = current
		node.set_meta(initial_key, original)
	elif not node.has_meta(initial_key):
		node.set_meta(initial_key, original)
	var localized := text_for(original, language)
	node.set_meta(last_key, localized)
	node.set_meta(locale_key, language)
	return localized

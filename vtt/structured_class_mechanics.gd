extends RefCounted

# Derived exclusively from structured 5etools classTableGroups, classFeatures
# and hd. The shipped JSON is generated by scripts/generate_class_mechanics.py.
const PATH := "res://vtt/data/structured_class_mechanics_5etools.json"
static var _cache: Array[Dictionary] = []
static var _loaded := false

# 5etools table columns have no "consumable" metadata. These are capacities
# for *selections*, not spendable resources. Favored Enemy's 2024 count is
# spell-related (free Hunter's Mark), handled by spellcasting instead.
const NON_CONSUMABLE := ["weapon mastery", "favored enemy"]


static func classes() -> Array[Dictionary]:
	if not _loaded:
		_loaded = true
		var file := FileAccess.open(PATH, FileAccess.READ)
		if file != null:
			var raw: Variant = JSON.parse_string(file.get_as_text())
			file.close()
			if raw is Dictionary:
				for entry: Variant in (raw as Dictionary).get("classes", []):
					if entry is Dictionary:
						_cache.append(entry)
	return _cache


static func class_definition(name: String, source: String = "") -> Dictionary:
	var fallback: Dictionary = {}
	for row: Dictionary in classes():
		if String(row.get("name", "")).nocasecmp_to(name) != 0:
			continue
		if String(row.get("source", "")).nocasecmp_to(source) == 0:
			return row
		# Legacy records may not have a source. Prefer the 2014 PHB identity.
		if fallback.is_empty() or (String(row.get("source", "")) == "PHB"
			and String(fallback.get("source", "")) != "PHB"):
			fallback = row
	return fallback if source.is_empty() else {}


static func hit_die(name: String, source: String = "") -> int:
	return int(class_definition(name, source).get("hit_dice", 0))


static func _number(value: Variant) -> int:
	if value is int or value is float:
		return int(value)
	if value is String and String(value).is_valid_int():
		return int(value)
	return 0


static func _numeric_column(values: Array) -> bool:
	if values.size() != 20:
		return false
	var found := false
	for raw: Variant in values:
		if raw == null:
			continue
		if raw is String and String(raw).to_lower() == "unlimited":
			found = true
			continue
		if raw is int or raw is float or (raw is String and String(raw).is_valid_int()):
			found = found or _number(raw) > 0
			continue
		# Typed dice, bonuses and bonusSpeed columns aren't uses.
		return false
	return found


static func _first_available_level(values: Array) -> int:
	for i: int in range(values.size()):
		if _number(values[i]) > 0 or String(values[i]).to_lower() == "unlimited":
			return i + 1
	return 0


static func _feature_for_column(definition: Dictionary, column: String, level: int) -> String:
	var wanted: String = column.to_lower()
	var singular: String = wanted.substr(0, wanted.length() - 1) if wanted.ends_with("s") else wanted
	var stem: String = wanted.trim_suffix(" points")
	var fallback := ""
	var best := ""
	var best_score := 0
	for feature: Variant in definition.get("features", []):
		if not feature is Dictionary or int(feature.get("level", 0)) != level:
			continue
		var name: String = String(feature.get("name", ""))
		var lower := name.to_lower()
		if fallback.is_empty():
			fallback = name
		var score := 0
		if lower == wanted or lower == singular:
			score = 100
		elif stem != wanted and (lower == stem or lower.contains(stem)):
			score = 90
		elif wanted.contains(lower) and lower.length() >= 3:
			score = 70
		if score > best_score:
			best = name
			best_score = score
	return best if best_score > 0 else fallback


static func resource_columns(definition: Dictionary) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for raw: Variant in definition.get("columns", []):
		if not raw is Dictionary:
			continue
		var column: Dictionary = raw
		var name: String = String(column.get("name", "")).strip_edges()
		var lower: String = name.to_lower()
		if lower in NON_CONSUMABLE or lower.is_empty():
			continue
		var values: Variant = column.get("levels", [])
		if not values is Array or not _numeric_column(values):
			continue
		var first: int = _first_available_level(values)
		var origin: String = _feature_for_column(definition, name, first)
		# A named class feature corresponding to a column signals a possible
		# resource, as do "Points" pools. Unmatched item/choice capacities
		# (e.g. Infused Items) must not become spendable trackers.
		var singular: String = lower.trim_suffix("s") if lower.ends_with("s") else lower
		var explicit_match := origin.to_lower() == lower or origin.to_lower() == singular
		var points: bool = lower.ends_with(" points")
		if not explicit_match and not points:
			continue
		result.append({
			"name": name, "column": name,
			"origin_feature": origin if not origin.is_empty() else name,
			"levels": values
		})
	return result

[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

uniform vec4 base_color : source_color = vec4(0.075, 0.085, 0.105, 1.0);
uniform vec4 minor_line_color : source_color = vec4(0.33, 0.36, 0.42, 1.0);
uniform vec4 major_line_color : source_color = vec4(0.58, 0.62, 0.70, 1.0);
uniform float cell_size = 1.0;
uniform float major_every = 5.0;

varying vec2 grid_pos;

float grid_line(vec2 p, float scale) {
	vec2 coord = p / scale;
	vec2 grid = abs(fract(coord - 0.5) - 0.5) / fwidth(coord);
	float line = min(grid.x, grid.y);
	return 1.0 - min(line, 1.0);
}

void vertex() {
	grid_pos = VERTEX.xz;
}

void fragment() {
	float minor = grid_line(grid_pos, cell_size);
	float major = grid_line(grid_pos, cell_size * major_every);
	vec3 color = base_color.rgb;
	color = mix(color, minor_line_color.rgb, minor * 0.78);
	color = mix(color, major_line_color.rgb, major);
	ALBEDO = color;
	ROUGHNESS = 1.0;
}
"

